# Committed, non-secret defaults for ToolPilot.
#
# v1 has no backend and therefore no secrets: every value here is a
# NEXT_PUBLIC_* variable that Next inlines into the public static bundle.
# Never add a credential to this file — there is nothing in v1 that needs one.
#
# Override locally in .env.local (gitignored). Vercel supplies the real value
# for preview and production; see docs/deploy.md.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
